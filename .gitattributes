# Cross-OS WSL2 <-> Windows line ending normalization
* text=auto eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary 3D formats, archives, and media assets
*.stl binary
*.3mf binary
*.lys binary
*.lyt binary
*.obj binary
*.ply binary
*.glb binary
*.gltf binary
*.step binary
*.stp binary
*.gcode binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.icns binary
*.zip binary
*.7z binary
*.rar binary
*.db binary
